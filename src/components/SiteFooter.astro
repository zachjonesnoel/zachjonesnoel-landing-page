---
import profile from '../../data/profile.json';
---
<!-- Site footer -->
<footer class="border-t border-border bg-bg py-8 pb-32">
  <div class="mx-auto max-w-content px-5">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="font-mono text-xs text-muted tracking-wider">Jones Zachariah Noel · zachjonesnoel</span>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
        {Object.entries(profile.socials).map(([name, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer"
             class="font-mono text-xs text-muted hover:text-accent transition-colors tracking-wider">{name}</a>
        ))}
      </div>
    </div>
    <p class="mt-4 text-center font-mono text-xs text-muted/40 tracking-wider">
      built with astro · tailwind · aws amplify — type <span class="text-accent">'help'</span> in the terminal below
    </p>
  </div>
</footer>
