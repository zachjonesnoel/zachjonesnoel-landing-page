---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import profile from '../../data/profile.json';
import talks from '../../data/talks.json';
import writing from '../../data/writing.json';

const realTalks = talks.filter(t => !t.id.includes('template'));
const realWriting = writing.filter(w => !w.id.includes('template')).sort((a, b) => b.date.localeCompare(a.date));

// Home-page summary stats. The full lists live on /talks, /writing and /shows.
const cityCount = new Set(realTalks.filter(t => t.location.lat != null && t.location.lng != null).map(t => `${t.location.lat},${t.location.lng}`)).size;
const upcomingCount = realTalks.filter(t => t.upcoming).length;
const latestTalk = realTalks[0];
const latestWriting = realWriting[0];
const writingByType: Record<string, number> = {};
for (const w of realWriting) writingByType[w.type] = (writingByType[w.type] ?? 0) + 1;

// Connect section: friendly labels, and the handle taken from each profile URL
const socialLabel: Record<string, string> = {
  twitter: 'X / Twitter', linkedin: 'LinkedIn', github: 'GitHub', devto: 'dev.to', instagram: 'Instagram',
};
const handleOf = (url: string) => '@' + (new URL(url).pathname.split('/').filter(Boolean).pop() ?? '').replace(/^@/, '');

// figlet "Small" font render of "zachjonesnoel" (53 cols x 5 rows)
const bannerRows: string[] = ["             _     _                               _ ","  _____ _ __| |_  (_)___ _ _  ___ ____ _  ___  ___| |"," |_ / _` / _| ' \\ | / _ \\ ' \\/ -_|_-< ' \\/ _ \\/ -_) |"," /__\\__,_\\__|_||_|/ \\___/_||_\\___/__/_||_\\___/\\___|_|","                |__/                                 "];
---
<Base>
<main id="gui-main" class="pt-14">

  <!-- ── HERO ── -->
  <section id="about" class="border-b border-border">
    <div class="mx-auto max-w-content px-5 py-20">
      <p class="font-mono text-xs text-accent tracking-widest mb-5">// developer relations engineer</p>
      <!-- Terminal banner: types the command, then scans the figlet banner in -->
      <div class="glow-box mb-8 max-w-xl overflow-hidden rounded-md border border-border bg-bg2 font-mono" data-term-banner>
        <div class="flex items-center gap-1.5 border-b border-border px-3 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-muted/40"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-muted/40"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-accent/60"></span>
          <span class="ml-3 text-[10px] tracking-wider text-muted">zach@nyc ~ zsh</span>
          <button type="button" data-replay class="ml-auto text-[10px] tracking-wider text-muted transition-colors hover:text-accent">↻ replay</button>
        </div>
        <div class="px-4 py-4 text-[11px] leading-relaxed" aria-hidden="true">
          <p class="whitespace-nowrap"><span class="text-accent">~</span> <span class="text-muted">$</span> <span class="text-txt" data-cmd>figlet zachjonesnoel</span></p>
          <pre class="mt-3 overflow-x-auto whitespace-pre text-[8px] leading-[1.15] text-accent md:text-[12px]" data-banner data-rows={JSON.stringify(bannerRows)}>{bannerRows.join('\n')}</pre>
          <p class="mt-4 whitespace-nowrap"><span class="text-accent">~</span> <span class="text-muted">$</span> <span class="cursor"></span></p>
        </div>
        <span class="sr-only">zachjonesnoel</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight mb-6">
        Hi, I'm Jones Zachariah Noel (<span class="text-accent">zach</span>).<br>
        <span class="mt-3 block">
        I bridge <span class="text-accent">developers</span><br>
        and great products.
        </span>
      </h1>
      <div class="mb-6 flex max-w-2xl flex-col items-start gap-5 sm:flex-row sm:gap-6">
      <img src="/Jones%20headshot.png" alt="Jones Zachariah Noel" width="112" height="112" loading="lazy"
        class="h-24 w-24 shrink-0 rounded-md border border-accent/40 bg-bg2 object-cover object-top grayscale transition duration-300 hover:grayscale-0 sm:h-28 sm:w-28" />
      <p class="text-base text-txt/70 max-w-lg leading-relaxed">
        Started as a full-stack engineer. Moved into solutions engineering.
        Now doing Developer Relations and Observability Advocacy at <a href="https://www.newrelic.com/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">New Relic</a>
        — because the best thing I can do for developers is make their experience
        with technology genuinely better.
      <span class="mt-3 block">
        Also an <a href="https://aws.amazon.com/developer/community/heroes/jones-zachariah-noel/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">AWS Serverless Hero</a>
        and co-organiser of <a href="https://www.meetup.com/awsugblr/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">AWS User Group Bengaluru</a>.
      </span>
      </p>
      </div>
      <ul class="mb-6 flex flex-wrap gap-2" aria-label="Focus areas">
        {['AWS Serverless Hero','Developer Experience','Serverless','Developer Relations','New Relic', 'Product Engineering', 'Solution Architecture','Technical Writing','Community Builder'].map(t => (
          <li class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs transition-colors ${t === 'AWS Serverless Hero'
            ? 'border-accent2/40 bg-accent2/10 text-accent2 font-semibold'
            : 'border-border bg-bg2 text-txt/80 hover:border-accent/50 hover:text-accent'}`}>
            {t === 'AWS Serverless Hero' && <span aria-hidden="true">★</span>}
            {t}
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-2">
        {Object.entries(profile.socials).map(([name, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[11px] hover:text-accent border border-border hover:border-accent/30 hover:bg-accent/5 px-3 py-1.5 rounded transition-all tracking-wider inline-flex items-center gap-2"
          ><SocialIcon name={name} class="h-3.5 w-3.5" />{name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TALKS (summary) ── -->
  <section id="talks" class="border-b border-border">
    <div class="mx-auto max-w-content px-5 py-12">
      <div class="flex justify-between items-center mb-6">
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-muted">Talks</span>
        <button class="cli-hint font-mono text-[10px] text-muted/50 hover:text-accent transition-colors" data-cmd="talks">$ talks</button>
      </div>

      <div class="flex flex-wrap gap-6 mb-6">
        <div>
          <span class="font-mono text-2xl font-bold text-txt">{realTalks.length}</span>
          <span class="font-mono text-xs text-muted ml-2">talks</span>
        </div>
        <div>
          <span class="font-mono text-2xl font-bold text-txt">{cityCount}</span>
          <span class="font-mono text-xs text-muted ml-2">cities</span>
        </div>
        <div>
          <span class="font-mono text-2xl font-bold text-accent">{upcomingCount}</span>
          <span class="font-mono text-xs text-muted ml-2">upcoming</span>
        </div>
      </div>

      <p class="text-sm text-txt/70 leading-snug mb-1.5">Latest: {latestTalk.title}</p>
      <p class="font-mono text-[11px] text-muted mb-5">{latestTalk.conference} · {latestTalk.location.city} · {latestTalk.date}</p>

      <a href="/talks" class="font-mono text-xs text-accent hover:underline">all talks &amp; map →</a>
    </div>
  </section>

  <!-- ── SPEAKING + MAP ── -->
  <section id="speaking" class="border-b border-border">
    <div class="mx-auto max-w-content px-5 py-12">

      <div class="flex justify-between items-center mb-6">
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-muted">Speaking</span>
        <button class="cli-hint font-mono text-[10px] text-muted/50 hover:text-accent transition-colors" data-cmd="map">
          <span class="text-accent mr-1">◎</span>map
        </button>
      </div>

      <p class="text-sm text-txt/60 max-w-lg leading-relaxed mb-5">
        Available for conferences, meetups, podcasts, and panels on serverless architecture,
        developer experience, observability, and the craft of DevRel.
      </p>

      <div class="flex flex-wrap gap-2 mb-8">
        {['Serverless & AWS','Developer Experience','Observability','DevRel craft','Community building','AWS Architecture'].map(tag => (
          <span class="font-mono text-xs text-muted border border-border px-3 py-1.5 rounded tracking-wider">{tag}</span>
        ))}
      </div>

      <!-- stats bar -->
      <div class="flex flex-wrap gap-6 mb-6">
        <div>
          <span class="font-mono text-2xl font-bold text-txt" id="map-city-count">—</span>
          <span class="font-mono text-xs text-muted ml-2">cities</span>
        </div>
        <div>
          <span class="font-mono text-2xl font-bold text-txt" id="map-talk-count">—</span>
          <span class="font-mono text-xs text-muted ml-2">talks</span>
        </div>
        <div>
          <span class="font-mono text-2xl font-bold text-accent" id="map-upcoming-count">—</span>
          <span class="font-mono text-xs text-muted ml-2">upcoming</span>
        </div>
      </div>

      <!-- Leaflet map -->
      <div
        id="talks-map"
        class="w-full rounded-md border border-border"
        style="height: 360px; background: #111111; position: relative; z-index: 0;"
        aria-label="World map showing conference talk locations"
        role="img"
      ></div>

      <p class="font-mono text-[10px] text-muted mt-3">
        <span class="text-accent">●</span> upcoming &nbsp;
        <span class="text-muted/60">●</span> past &nbsp;·&nbsp;
        hover a pin for details
      </p>

      <!-- upcoming talks sub-list -->
      <div id="upcoming-talks-list" class="mt-6 hidden">
        <p class="font-mono text-[11px] tracking-widest uppercase text-accent mb-3">Upcoming</p>
        <div id="upcoming-talks-items" class="flex flex-col"></div>
      </div>

    </div>
  </section>

  <!-- ── WRITING (summary) ── -->
  <section id="writing" class="border-b border-border">
    <div class="mx-auto max-w-content px-5 py-12">
      <div class="flex justify-between items-center mb-6">
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-muted">Writing</span>
        <button class="cli-hint font-mono text-[10px] text-muted/50 hover:text-accent transition-colors" data-cmd="writing">$ writing</button>
      </div>

      <div class="flex flex-wrap gap-6 mb-6">
        <div>
          <span class="font-mono text-2xl font-bold text-txt">{realWriting.length}</span>
          <span class="font-mono text-xs text-muted ml-2">pieces</span>
        </div>
        {Object.entries(writingByType).map(([type, count]) => (
          <div>
            <span class="font-mono text-2xl font-bold text-txt">{count}</span>
            <span class="font-mono text-xs text-muted ml-2">{type}</span>
          </div>
        ))}
      </div>

      <p class="text-sm text-txt/70 leading-snug mb-1.5">Latest: {latestWriting.title}</p>
      <p class="font-mono text-[11px] text-muted mb-5">{latestWriting.platform} · {latestWriting.date}</p>

      <a href="/writing" class="font-mono text-xs text-accent hover:underline">all writing →</a>
    </div>
  </section>

  <!-- ── SHOWS (summary) ── -->
  <section id="shows" class="border-b border-border">
    <div class="mx-auto max-w-content px-5 py-12">
      <div class="flex justify-between items-center mb-6">
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-muted">Shows &amp; community</span>
        <button class="cli-hint font-mono text-[10px] text-muted/50 hover:text-accent transition-colors" data-cmd="shows">$ shows</button>
      </div>

      <div class="flex flex-wrap gap-6 mb-5">
        <div>
          <span class="font-mono text-2xl font-bold text-txt">{profile.shows.length}</span>
          <span class="font-mono text-xs text-muted ml-2">shows</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5">
        {profile.shows.map(s => (
          <a href="/shows" class="glow-box group flex flex-col border border-border rounded-md bg-bg2 overflow-hidden hover:border-accent transition-colors">
            <div class="flex items-center justify-center h-28 bg-bg px-4 py-3">
              <img src={s.logo} alt={`${s.name} logo`} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
            </div>
            <div class="px-3 py-2.5 border-t border-border">
              <p class="text-xs font-semibold group-hover:text-accent transition-colors">{s.name}</p>
              <p class="font-mono text-[10px] tracking-widest uppercase text-muted mt-0.5">{s.type}</p>
            </div>
          </a>
        ))}
      </div>

      <a href="/shows" class="font-mono text-xs text-accent hover:underline">all shows →</a>
    </div>
  </section>

  <!-- ── CONSULT ── -->
  <section id="consult">
    <div class="mx-auto max-w-content px-5 py-12">
      <div class="glow-box border border-amber-500/20 rounded-lg p-7 bg-amber-500/[0.02]">
        <div class="flex justify-between items-start mb-3">
          <p class="font-mono text-[10px] tracking-widest uppercase text-accent2">// available for consultations</p>
          <button class="cli-hint font-mono text-[10px] text-muted/50 hover:text-accent transition-colors" data-cmd="consult">$ consult</button>
        </div>
        <h2 class="text-xl font-semibold mb-3">Work with me</h2>
        <p class="text-sm text-txt/60 leading-relaxed max-w-lg mb-5">
          I help developer-focused companies build better DevRel programs, sharpen their
          developer experience, and create content strategies that actually move the needle.
          Former engineer-turned-DevRel — I understand both sides of the table.
        </p>
        <div class="flex flex-wrap gap-2 mb-6">
          {profile.consultAreas.map(a => (
            <span class="font-mono text-[11px] text-accent2 border border-amber-500/25 px-2 py-0.5 rounded">{a}</span>
          ))}
        </div>
        <a
          href={profile.calendly || `mailto:${profile.email}`}
          class="inline-block bg-accent2 text-black font-mono text-xs font-semibold tracking-wider px-5 py-2.5 rounded hover:opacity-90 transition-opacity"
        >→ get in touch</a>
      </div>
    </div>
  </section>

  <!-- ── CONNECT ── -->
  <section id="connect" class="border-t border-border">
    <div class="mx-auto max-w-content px-5 py-12">
      <div class="flex justify-between items-center mb-6">
        <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-muted">Connect</span>
      </div>

      <h2 class="text-xl font-semibold mb-2">Let's connect</h2>
      <p class="text-sm text-txt/60 leading-relaxed max-w-lg mb-6">
        Follow along, ask a question, or say hello on any of these channels.
        Prefer a direct chat? Book a call.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {Object.entries(profile.socials).map(([key, url]) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="glow-box group flex items-center justify-between gap-3 border border-border rounded-md px-4 py-3 bg-bg2"
          >
            <SocialIcon name={key} class="h-5 w-5 shrink-0 text-muted group-hover:text-accent transition-colors" />
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[10px] tracking-widest uppercase text-muted">{socialLabel[key] ?? key}</p>
              <p class="font-mono text-sm text-txt truncate group-hover:text-accent transition-colors">{handleOf(url)}</p>
            </div>
            <span class="font-mono text-accent shrink-0">↗</span>
          </a>
        ))}
      </div>

      <p class="font-mono text-[10px] tracking-widest uppercase text-muted mb-3">Shows &amp; publications</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
        {profile.shows.map(s => (
          <a
            href={s.playlist ?? s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="glow-box group flex items-center justify-between gap-3 border border-border rounded-md px-4 py-3 bg-bg2"
          >
            <div class="min-w-0">
              <p class="font-mono text-[10px] tracking-widest uppercase text-muted">{s.type}</p>
              <p class="text-sm text-txt truncate group-hover:text-accent transition-colors">{s.name}</p>
            </div>
            <span class="font-mono text-accent shrink-0">↗</span>
          </a>
        ))}
      </div>

      <div class="flex flex-wrap gap-2">
        <a
          href={profile.calendly}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-black font-mono text-xs font-semibold tracking-wider px-5 py-2.5 rounded hover:opacity-90 transition-opacity"
        >→ book a call</a>
        <button
          type="button"
          data-share-page
          class="font-mono text-xs text-muted border border-border px-4 py-2.5 rounded hover:border-accent hover:text-accent transition-colors"
        >share this page</button>
      </div>
    </div>
  </section>
</main>

<!-- ══════════════════════════════════════════════
     SEMANTIC FALLBACK (crawlers only)
═══════════════════════════════════════════════ -->
<div class="sr-only">
  <h1>{profile.name} — {profile.title} at {profile.employer}</h1>
  <p>{profile.bio}</p>
  <section aria-label="Conference talks">
    <h2>Talks</h2>
    <ul>
      {talks.map(t => (
        <li><strong>{t.title}</strong> — {t.conference}, {t.date}, {t.location.city}, {t.location.country}</li>
      ))}
    </ul>
  </section>
  <section aria-label="Writing">
    <h2>Writing</h2>
    <ul>
      {writing.map(w => (
        <li><a href={w.url}>{w.title}</a> — {w.platform}, {w.date}</li>
      ))}
    </ul>
  </section>
</div>

<!-- Terminal banner animation (hero) -->
<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

    function init(root) {
      const pre    = root.querySelector('[data-banner]');
      const cmdEl  = root.querySelector('[data-cmd]');
      const replay = root.querySelector('[data-replay]');
      if (!pre || !cmdEl) return;

      const rows    = JSON.parse(pre.dataset.rows || '[]');
      const command = cmdEl.textContent || '';
      const width   = Math.max(...rows.map(r => r.length));
      const blank   = rows.map(() => '').join('\n');
      let run = 0;

      async function play() {
        const id = ++run;
        const alive = () => id === run;

        if (reduceMotion) {
          cmdEl.textContent = command;
          pre.textContent = rows.join('\n');
          return;
        }

        // 1. type the command
        pre.textContent = blank;
        cmdEl.textContent = '';
        for (let i = 1; i <= command.length; i++) {
          if (!alive()) return;
          cmdEl.textContent = command.slice(0, i);
          await sleep(45);
        }
        await sleep(250);

        // 2. scan the banner in left to right, with a bar at the scan edge
        for (let col = 0; col <= width; col += 2) {
          if (!alive()) return;
          pre.textContent = rows
            .map(r => r.slice(0, col).padEnd(col, ' ') + (col < width ? '▌' : ''))
            .join('\n');
          await sleep(22);
        }
        pre.textContent = rows.join('\n');
      }

      replay?.addEventListener('click', play);
      play();
    }

    document.querySelectorAll('[data-term-banner]').forEach(init);
  })();
</script>

<!-- Connect buttons: share the page, with brief feedback -->
<script is:inline>
  (function () {
    const flash = (btn, text) => {
      const original = btn.dataset.label || btn.textContent;
      btn.dataset.label = original;
      btn.textContent = text;
      setTimeout(() => { btn.textContent = original; }, 1800);
    };

    document.querySelectorAll('[data-share-page]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const data = { title: document.title, url: window.location.href };
        try {
          if (navigator.share) {
            await navigator.share(data);
          } else {
            await navigator.clipboard.writeText(data.url);
            flash(btn, 'link copied ✓');
          }
        } catch (e) {
          // user dismissed the share sheet, or clipboard blocked: nothing to do
        }
      });
    });
  })();
</script>

</Base>
